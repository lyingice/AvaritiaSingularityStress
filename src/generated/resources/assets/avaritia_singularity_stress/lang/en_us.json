  "avaritia_singularity_stress.ponder.warp_tunnel.text_2": "One filter slot per side",
  "avaritia_singularity_stress.ponder.warp_tunnel.text_3": "Put a second one on another belt",
  "avaritia_singularity_stress.ponder.warp_tunnel.text_4": "Wrench one side, then a side on the other tunnel",
  "avaritia_singularity_stress.ponder.warp_tunnel.text_5": "Comes out on the side you picked",
